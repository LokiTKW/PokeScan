{
  "name": "pokescan2",
  "productName": "PokeScan 2",
  "version": "2.7.0",
  "description": "PokéScan 2 – darmowy skaner kart Pokémon TCG na Windows: telefon jako skaner, rozpoznawanie bez AI, wycena z Cardmarket, Allegro i Vinted, Pokédexy setów.",
  "author": "PokéScan contributors",
  "private": true,
  "main": "build/main.js",
  "scripts": {
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:main": "esbuild electron/main.js --bundle --platform=node --target=node20 --external:electron --outfile=build/main.js && node scripts/copy-static.js",
    "build": "npm run build:ui && npm run build:main",
    "start": "npm run build && electron .",
    "server": "npm run build && node build/main.js --server-only",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.pokescan2.desktop",
    "productName": "PokeScan 2",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**",
      "dist/**",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PokéScan 2",
      "artifactName": "PokeScan2-Setup-${version}.${ext}"
    },
    "artifactName": "PokeScan2-${version}-win-${arch}.${ext}",
    "publish": null
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@techstark/opencv-js": "^4.10.0-release.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.71.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "selfsigned": "^2.4.1",
    "tesseract.js": "^6.0.1",
    "tesseract.js-core": "^6.1.2",
    "vite": "^6.4.6"
  },
  "license": "MIT"
}
